# ==============================================================================
# CODEWARD FRONTEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Set these variables in Cloudflare Pages Dashboard -> Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. API & WEBSOCKET CONNECTIONS (Pointing to Railway Backend)
# ------------------------------------------------------------------------------
# The HTTPS URL of your Railway API backend
VITE_API_URL=https://codewardapi-production.up.railway.app

# The WSS WebSocket URL for real-time agent activity feed
VITE_WS_URL=wss://codewardapi-production.up.railway.app/ws/feed

# ------------------------------------------------------------------------------
# 2. ANALYTICS & TELEMETRY (Optional)
# ------------------------------------------------------------------------------
# PostHog Analytics key and host
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN for frontend error reporting
# VITE_SENTRY_DSN=https://...
