# ==============================================================================
# CODEWARD API - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Use this file to set environment variables on Railway / production hosting.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node server (Railway sets this automatically, default is 3000)
PORT=3000

# Node environment: 'development' or 'production'
NODE_ENV=production

# Base URL of the API server (e.g. Railway public domain)
API_URL=https://codewardapi-production.up.railway.app

# Base URL of the Frontend app (e.g. Cloudflare Pages or custom domain)
FRONTEND_URL=https://codeward.cloud

# Secret key used by Better-Auth for session signing (min 32 characters)
BETTER_AUTH_SECRET=generate-a-secure-random-32-char-string-here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase / Postgres)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (Supabase -> Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Supabase REST / Client Credentials (if API performs client operations)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 3. REDIS & QUEUE CONFIGURATION (Upstash Redis)
# ------------------------------------------------------------------------------
# Redis connection URL for BullMQ job queue (rediss:// for SSL)
UPSTASH_REDIS_URL=rediss://default:[TOKEN]@[HOST]:6379

# Upstash REST API credentials (optional fallback)
UPSTASH_REDIS_REST_URL=https://[HOST].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# 4. GITHUB APP CREDENTIALS
# ------------------------------------------------------------------------------
# GitHub App App ID, Client ID, Client Secret, and Private Key
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret-string
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH CREDENTIALS (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-api-name.up.railway.app/api/integrations/google/callback

# ------------------------------------------------------------------------------
# 6. AI SDK & LLM PROVIDERS
# ------------------------------------------------------------------------------
TOKENROUTER_API_KEY=your-tokenrouter-api-key
TOKENROUTER_MODEL=z-ai/glm-5.3-free
OPENAI_API_KEY=your-openai-api-key
AGENTROUTER_API_KEY=your-agentrouter-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# AI_CASCADE_TIMEOUT_MS=90000

# ------------------------------------------------------------------------------
# 7. INTEGRATIONS & EXTERNAL SERVICES (Optional)
# ------------------------------------------------------------------------------
# Fly.io API token for ephemeral sandbox containers
FLY_API_TOKEN=your-fly-api-token

# Email Delivery (Resend API)
RESEND_API_KEY=re_your_resend_api_key

# Newsletter subscription (Brevo / Sendinblue)
BREVO_API_KEY=your-brevo-api-key

# Email verification service
QUICKEMAILVERIFICATION_API_KEY=your-quickemailverification-api-key

# ------------------------------------------------------------------------------
# 8. QUEUE CONCURRENCY, FAIRNESS & WORKER SCALING
# ------------------------------------------------------------------------------
# Number of agent jobs processed concurrently by the BullMQ worker
WORKER_CONCURRENCY=10

# Dedicated escalation queue concurrency (decoupled from agent worker)
ESCALATION_CONCURRENCY=3

# GitHub Issues rate limit max issues created per minute
GITHUB_ISSUE_RATE_MAX=20

# Run worker threads in the same process as the HTTP server (convenient for local dev)
# In production, set to false and deploy 'pnpm run worker' as a dedicated worker service.
RUN_WORKER_INLINE=true

# Sandbox Provider ('local' for local exec, 'fly' for production Fly.io machines)
SANDBOX_PROVIDER=local
FLY_SANDBOX_IMAGE=registry.fly.io/codeward-sandboxes-v2:deployment-01KV13ANZ9AJNNPAXN4A75G44Y

# ------------------------------------------------------------------------------
# 9. POLAR BILLING (https://polar.sh/dashboard)
# ------------------------------------------------------------------------------
# Webhook signing secret — Polar Dashboard → Webhooks → your endpoint → Secret
# Uses Standard Webhooks spec (same pattern as Stripe). REQUIRED in production.
POLAR_WEBHOOK_SECRET=whsec_your_polar_webhook_secret

# Product IDs — Polar Dashboard → Products → copy the ID for each tier
POLAR_PRO_PRODUCT_ID=prod_your_pro_product_id
POLAR_TEAM_PRODUCT_ID=prod_your_team_product_id

# Server-side Polar API access token (needed for /webhooks/upgrade dynamic checkout)
# Polar Dashboard → Settings → API Keys
POLAR_ACCESS_TOKEN=pat_your_polar_access_token

# Override the upgrade page URL (defaults to FRONTEND_URL/pricing)
# POLAR_UPGRADE_URL=https://codeward.cloud/pricing

# ------------------------------------------------------------------------------
# 10. BILLING PLAN QUOTAS
# ------------------------------------------------------------------------------
# Lifetime PR scan limit for free-tier orgs (default: 10 distinct PR numbers)
TRIAL_PR_LIMIT=10

# Monthly PR scan limit for Pro-tier orgs (default: 100)
PRO_PR_LIMIT=100

# ------------------------------------------------------------------------------
# 11. GLOBAL BUDGET SENTINEL
# ------------------------------------------------------------------------------
# Hard monthly LLM spend cap in USD. When exceeded, ALL new scans are blocked.
GLOBAL_MONTHLY_BUDGET_LIMIT_USD=500

# Set to 'true' to instantly block all new scans regardless of budget.
# Use as a manual emergency brake.
GLOBAL_KILL_SWITCH=false

# How long (seconds) the Redis-cached budget figure stays valid (default: 300 = 5 min)
BUDGET_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 12. EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Sender address for all outbound emails (must be verified in Resend)
EMAIL_FROM_ADDRESS=Codeward <hello@codeward.cloud>

# Support email shown in email footers
SUPPORT_EMAIL=support@codeward.cloud

