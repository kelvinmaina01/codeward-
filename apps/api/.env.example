# ==============================================================================
# CODEWARD API - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Use this file to set environment variables on Railway / production hosting.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node server (Railway sets this automatically, default is 3000)
PORT=3000

# Node environment: 'development' or 'production'
NODE_ENV=production

# Base URL of the API server (e.g. Railway public domain)
API_URL=https://your-api-name.up.railway.app

# Base URL of the Frontend app (e.g. Cloudflare Pages or custom domain)
FRONTEND_URL=https://your-app-name.pages.dev

# Secret key used by Better-Auth for session signing (min 32 characters)
BETTER_AUTH_SECRET=generate-a-secure-random-32-char-string-here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase / Postgres)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (Supabase -> Project Settings -> Database -> Connection String URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Supabase REST / Client Credentials (if API performs client operations)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 3. REDIS & QUEUE CONFIGURATION (Upstash Redis)
# ------------------------------------------------------------------------------
# Redis connection URL for BullMQ job queue (rediss:// for SSL)
UPSTASH_REDIS_URL=rediss://default:[TOKEN]@[HOST]:6379

# Upstash REST API credentials (optional fallback)
UPSTASH_REDIS_REST_URL=https://[HOST].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ------------------------------------------------------------------------------
# 4. GITHUB APP CREDENTIALS
# ------------------------------------------------------------------------------
# GitHub App App ID, Client ID, Client Secret, and Private Key
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret-string
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH CREDENTIALS (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-api-name.up.railway.app/api/integrations/google/callback

# ------------------------------------------------------------------------------
# 6. AI SDK & LLM PROVIDERS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key
AGENTROUTER_API_KEY=sk-your-agentrouter-key
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ------------------------------------------------------------------------------
# 7. INTEGRATIONS & EXTERNAL SERVICES (Optional)
# ------------------------------------------------------------------------------
# Fly.io API token for ephemeral sandbox containers
FLY_API_TOKEN=your-fly-api-token

# Email Delivery (Resend API)
RESEND_API_KEY=re_your_resend_api_key

# Newsletter subscription (Brevo / Sendinblue)
BREVO_API_KEY=your-brevo-api-key

# Email verification service
QUICKEMAILVERIFICATION_API_KEY=your-quickemailverification-api-key

# Number of agents processed concurrently by the BullMQ worker
WORKER_CONCURRENCY=10
