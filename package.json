{
  "name": "codeward-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinmaina01/codeward-.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build:web": "npm run build --prefix apps/web",
    "build:api": "npm run build --prefix apps/api",
    "build": "npm run build:api && npm run build:web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "deploy:web": "npm run deploy --prefix apps/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
